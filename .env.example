# Copie ce fichier en « .env.local » (ignoré par git).
# Valeurs : tableau de bord Supabase → Project Settings → API.
# Laisse vide pour une appli 100 % locale (contenu de démonstration, pas de compte).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Uniquement pour les scripts d'administration/agents (JAMAIS dans l'appli, JAMAIS commité) :
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
