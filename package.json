    "content:validate": "tsx scripts/content/validate.ts",
    "content:verify-sources": "tsx scripts/content/verify-sources.ts",
    "content:bundle": "tsx scripts/content/bundle.ts",
    "content:maintenance": "tsx scripts/content/maintenance.ts",
    "wiki": "tsx scripts/content/wiki.ts"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "5.3.0",
    "idb-keyval": "6.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "fake-indexeddb": "6.2.7",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  }
