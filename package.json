{
  "name": "grand-savoir",
  "private": true,
  "version": "1.0.0",
  "description": "Le Grand Savoir : jeu de culture générale avec répétition espacée (PWA)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run content:bundle && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "content:validate": "tsx scripts/content/validate.ts",
    "content:verify-sources": "tsx scripts/content/verify-sources.ts",
    "content:bundle": "tsx scripts/content/bundle.ts",
    "content": "tsx scripts/content/cli.ts",
    "agent:intake": "tsx scripts/agent/intake.ts",
    "agent:apply": "tsx scripts/agent/apply-proposal.ts",
    "agent:finish": "tsx scripts/agent/finish-run.ts",
    "backup": "tsx scripts/backup.ts"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "idb-keyval": "6.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.7",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
