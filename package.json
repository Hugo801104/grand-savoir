{
  "name": "grand-savoir",
  "private": true,
  "version": "1.0.0",
  "description": "Le Grand Savoir : jeu de culture générale avec répétition espacée (PWA)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run content:bundle && tsc --noEmit && vite build",
